{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/dashboard",
      "destination": "/api?view=dashboard"
    },
    {
      "source": "/api/activity",
      "destination": "/api?view=activity"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.py": {
      "includeFiles": "score_backend/data/**",
      "maxDuration": 30
    }
  }
}
