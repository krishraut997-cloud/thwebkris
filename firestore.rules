rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isCourseAdmin() {
      return signedIn()
        && request.auth.token.email == 'emeye1911@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function validCourseProgress(userId) {
      let data = request.resource.data;
      let progress = data.progress;
      return data.keys().hasOnly([
          'uid', 'email', 'displayName', 'progress', 'createdAt', 'updatedAt', 'lastActiveAt'
        ])
        && data.uid == userId
        && data.email == request.auth.token.email
        && data.displayName is string
        && data.displayName.size() <= 100
        && progress is map
        && progress.keys().hasOnly([
          'completedLessons', 'passedExercises', 'attempts', 'hintsUsed',
          'firstTryPasses', 'earned', 'xp', 'level', 'runs', 'activeDays',
          'visitedLevels', 'currentLesson'
        ])
        && progress.completedLessons is list
        && progress.completedLessons.size() <= 36
        && progress.passedExercises is map
        && progress.passedExercises.size() <= 72
        && progress.attempts is map
        && progress.attempts.size() <= 72
        && progress.hintsUsed is map
        && progress.hintsUsed.size() <= 72
        && progress.firstTryPasses is list
        && progress.firstTryPasses.size() <= 72
        && progress.earned is list
        && progress.earned.size() <= 30
        && progress.xp is int
        && progress.xp >= 0
        && progress.level is int
        && progress.level >= 1
        && progress.runs is int
        && progress.runs >= 0
        && progress.activeDays is list
        && progress.activeDays.size() <= 14
        && progress.visitedLevels is list
        && progress.visitedLevels.size() <= 4
        && progress.currentLesson is string
        && data.updatedAt == request.time
        && data.lastActiveAt == request.time;
    }

    match /courseProgress/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isCourseAdmin());
      allow list: if isCourseAdmin();
      allow create: if signedIn()
        && request.auth.uid == userId
        && validCourseProgress(userId)
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn()
        && request.auth.uid == userId
        && validCourseProgress(userId)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    match /players/{playerId} {
      allow read: if true;
      allow create: if signedIn()
        && request.auth.uid == playerId
        && request.resource.data.keys().hasOnly([
          'name', 'nameKey', 'points', 'gamesPlayed', 'wins', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.nameKey is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 24
        && request.resource.data.name.matches('^[a-z0-9]+( [a-z0-9]+)*$')
        && request.resource.data.nameKey == 'name-' + request.resource.data.name
        && request.resource.data.points == 0
        && request.resource.data.gamesPlayed == 0
        && request.resource.data.wins == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && getAfter(
          /databases/$(database)/documents/playerNames/$(request.resource.data.nameKey)
        ).data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    match /playerNames/{nameKey} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(
          /databases/$(database)/documents/players/$(request.auth.uid)
        ).data.nameKey == nameKey
        && nameKey == 'name-' + getAfter(
          /databases/$(database)/documents/players/$(request.auth.uid)
        ).data.name;
      allow update, delete: if false;
    }

    match /gameSessions/{sessionId} {
      allow read, write: if false;
    }

    match /gameRecords/{recordId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
