rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /players/{playerId} {
      allow read: if true;
      allow create: if signedIn()
        && request.auth.uid == playerId
        && request.resource.data.keys().hasOnly([
          'name', 'nameKey', 'points', 'gamesPlayed', 'wins', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.nameKey is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 24
        && request.resource.data.name.matches('^[a-z0-9]+( [a-z0-9]+)*$')
        && request.resource.data.nameKey == 'name-' + request.resource.data.name
        && request.resource.data.points == 0
        && request.resource.data.gamesPlayed == 0
        && request.resource.data.wins == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && getAfter(
          /databases/$(database)/documents/playerNames/$(request.resource.data.nameKey)
        ).data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    match /playerNames/{nameKey} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(
          /databases/$(database)/documents/players/$(request.auth.uid)
        ).data.nameKey == nameKey
        && nameKey == 'name-' + getAfter(
          /databases/$(database)/documents/players/$(request.auth.uid)
        ).data.name;
      allow update, delete: if false;
    }

    match /gameSessions/{sessionId} {
      allow read, write: if false;
    }

    match /gameRecords/{recordId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
